<mvc:View controllerName="zbidmatrixapp.controller.z_main_view"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page" title="{i18n>title}">
      <content>
            <VBox id="_IDGenVBox1" class="sapUiMediumMargin">
                <HBox id="_IDGenHBox" alignItems="Center">
            <!--    <Button id="previewBtn" text="Excel Preview" press="onPreview"/> 
                    <BusyIndicator id="busyIndicator" visible="false"/> -->
                </HBox>
                <MessageStrip id="msgStrip" visible="false"/>
                <core:HTML id="_IDGenHTML"
                    sanitizeContent="false"
                    content="&lt;div id='excelPreviewWrapper'&gt;
                        &lt;div id='sheetTabBar'&gt;&lt;/div&gt;
                        &lt;div id='excelTableContainer'&gt;
                            &lt;table id='excelTable'&gt;&lt;/table&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;"/>
            </VBox>
        </content>
    </Page>
</mvc:View>